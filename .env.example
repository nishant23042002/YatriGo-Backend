APP_MODE=production
LOG_LEVEL=INFO
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/yatrigo
REDIS_URL=redis://127.0.0.1:6379
SOCKET_CORS_ORIGIN=*
AUTH_ENABLED=false
AUTH_JWT_SECRET=change-me
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
INITIAL_SEARCH_RADIUS_KM=2
MAX_SEARCH_RADIUS_KM=8
DISPATCH_BATCH_SIZE=3
DISPATCH_RESPONSE_TTL_MS=12000
DISPATCH_RESERVATION_TTL_MS=14000
DISPATCH_RETRY_DELAY_MS=1500
DISPATCH_MAX_ROUNDS=4
DISPATCH_CANDIDATE_MULTIPLIER=6
DRIVER_HEARTBEAT_TTL_SECONDS=15
DRIVER_RECONCILE_INTERVAL_MS=15000
DRIVER_REJECT_COOLDOWN_SECONDS=10
DISPATCH_RECOVERY_INTERVAL_MS=10000
ETA_AVERAGE_SPEED_KMPH=28
PRICING_CURRENCY=INR
DEFAULT_RIDE_TYPE=STANDARD
PRICING_BASE_FARE=40
PRICING_PER_KM=12
PRICING_PER_MINUTE=2
PRICING_MINIMUM_FARE=60
PRICING_WAITING_PER_MINUTE=1.5
PRICING_COMMISSION_PERCENT=20
REQUEST_RIDE_RATE_LIMIT_MAX=5
REQUEST_RIDE_RATE_LIMIT_WINDOW_SECONDS=60
ACCEPT_RIDE_RATE_LIMIT_MAX=20
ACCEPT_RIDE_RATE_LIMIT_WINDOW_SECONDS=60
REDIS_ACTIVE_RIDE_TTL_SECONDS=3600
REDIS_REALTIME_STATE_TTL_SECONDS=21600
IDEMPOTENCY_TTL_SECONDS=86400
LOCK_TTL_MS=5000
SOCKET_EVENT_ACK_TTL_SECONDS=600
